<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The app is not sandboxed (it reads database files and SQL scripts anywhere the user points
       it), so hardened runtime is the only restriction. -->
  <!-- Oracle's Instant Client is installed by the user and signed by Oracle, not by us: without
       this the hardened runtime refuses to load its libraries. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Database drivers make outgoing connections. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
