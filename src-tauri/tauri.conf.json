{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clew",
  "version": "0.1.0",
  "identifier": "dev.adk.clew",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clew",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "backgroundColor": "#0e1014",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "publisher": "ADK",
    "copyright": "Copyright (c) 2026 ADK",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "Open-source database IDE",
    "longDescription": "Clew is an open-source database IDE for macOS and Windows: SQL and NoSQL browsers, a SQL console, a data grid and a bring-your-own-model AI assistant.",
    "resources": {
      "resources/THIRD_PARTY_LICENSES.html": "THIRD_PARTY_LICENSES.html"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDRjM1RUE0MThFMzI1NUEKUldSYUplTVlwRjd6bkU0eWNyUHJ6ZHVBc01HcGd3V0xCK0tpMzRZU3o1YllYaVg5TmRZUVR5M2UK",
      "endpoints": [
        "https://github.com/karthikkumararun/clew/releases/latest/download/latest.json"
      ]
    }
  }
}
