{
  "name": "clew",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "tauri": "tauri",
    "icons": "tsx scripts/build-icons.ts",
    "check:icons": "tsx scripts/check-icons.ts",
    "qa:build": "tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "qa:e2e": "tsx scripts/qa-e2e.ts",
    "qa:parity": "tsx scripts/seed-parity.ts",
    "check:no-test-mode": "tsx scripts/check-no-test-mode.ts",
    "dev:app": "tauri dev --config src-tauri/tauri.dev.conf.json"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-virtual": "^3.14.14",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "codemirror": "^6.0.2",
    "lodash": "^4.18.1",
    "marked": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql-formatter": "^15.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash": "^4.17.26",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
